#!/bin/sh
# mount.fuse.fuse2fs — util-linux mount helper: `mount -t fuse.fuse2fs DEV DIR`
# execs the fuse2fs daemon. Installed at /sbin/mount.fuse.fuse2fs in the guest
# rootfs; mount(8) dispatches here for fstype "fuse.fuse2fs" (and, via the
# mount.fuse dispatcher, for plain "-t fuse" with a block-device source).
dev=$1; mnt=$2; shift 2
opts=""
while [ $# -gt 0 ]; do
	case $1 in
	-o) opts=$2; shift 2 ;;
	*) shift ;;
	esac
done

# remount: the caller wants mount(2) MS_REMOUNT on the existing fuse mount,
# not a second fuse2fs instance racing for the device (EBUSY, the
# generic/294+452 "Device or resource busy" signature). -i stops util-linux
# from dispatching back into this helper.
case ",$opts," in
*,remount,*) exec mount -i -o "$opts" "$mnt" ;;
esac

# device already mounted: kernel filesystems share one superblock across any
# number of mountpoints; a second fuse2fs daemon on the same device can't
# (it EBUSYs on the open block device). Bind from the first mountpoint gives
# the same-superblock semantics the tests expect (generic/409-411/589/732).
first=$(awk -v d="$dev" '$1==d && $3 ~ /^fuse/ {print $2; exit}' /proc/mounts)
if [ -n "$first" ]; then
	# same device on the SAME mountpoint again: nothing to do. A second
	# daemon would EBUSY, and a self-bind stacks a duplicate mount entry
	# that trips the harness' _check_if_dev_already_mounted on the next
	# test (the KVM 441/777 abort chain).
	[ "$first" = "$mnt" ] && exit 0
	mount -i --bind "$first" "$mnt" || exit 1
	# a fresh mount(2) of a device is NOT a propagation peer of existing
	# mounts of that device; a bind joins the source's peer group when the
	# source is shared, leaking submounts across "independent" mountpoints
	# (generic/409/411 extra mount-table entries). Reset to private; tests
	# that want sharing set it explicitly afterwards.
	exec mount -i --make-private "$mnt"
fi

# strip options mount(8) adds that fuse2fs/libfuse doesn't accept
opts=$(echo "$opts" | tr ',' '\n' | grep -vE '^(rw|nofail|_netdev)$' | paste -sd, -)
# kernel mode (fuse2fs -o kernel): the upstream "behave like kernel ext4"
# switch. Expands to allow_other,default_permissions,suid,dev, force-enables
# POSIX ACL enforcement, and defers permission checks to the kernel — which
# also fixes daemon-side checks that can't see supplementary groups
# (the generic/683-685 fallocate-EPERM class). Parity, not masking: the
# hand-rolled allow_other,default_permissions we shipped before this was a
# strict subset that silently left acl, suid and dev off.
# remember=-1 (libfuse highlevel): never forget nodeids while mounted.
# Kernel filesystems never invalidate an open_by_handle decode because an
# inode fell out of cache; libfuse's default immediate-forget does exactly
# that (generic/426/467/756/777 same-session ESTALE, probe-verified fix).
# Cost is bounded: one pinned nodeid per inode touched, per-test mounts.
# nonempty (kernel-mount parity for non-empty mountpoints) exists only in
# libfuse2; libfuse3-based fuse2fs (>=1.47.3) dropped the check AND the
# option, so try without it first and fall back for old binaries.
STD="kernel,remember=-1"
[ -n "$opts" ] && STD="$STD,$opts"
/usr/bin/fuse2fs -o "$STD" "$dev" "$mnt" && exit 0
exec /usr/bin/fuse2fs -o "nonempty,$STD" "$dev" "$mnt"
